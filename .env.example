# Copy this file to .env and fill in the values you have.
#
# GEMINI_API_KEY lets `graphify extract` run semantic extraction headlessly
# from the command line (see docs/graphify.md), instead of needing an agent
# session to act as the LLM. graphify does not load .env files itself — source
# this one into your shell first, e.g.: set -a; source .env; set +a

GEMINI_API_KEY=
